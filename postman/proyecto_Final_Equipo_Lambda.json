        {
          "name": "1. Reportar Mascota Desaparecida",
          "request": {
            "method": "POST",
            "header": [ { "key": "Authorization", "value": "Bearer TOKEN" } ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "nombre", "value": "Rocky", "type": "text" },
                { "key": "especie", "value": "Perro", "type": "text" },
                { "key": "zonaDesaparicion", "value": "Parque Central", "type": "text" },
                { "key": "fechaDesaparicion", "value": "2023-10-25", "type": "text" },
                { "key": "telefonoContacto", "value": "5551234567", "type": "text" },
                { "key": "foto", "type": "file", "src": [] }
              ]
            },
            "url": { "raw": "http://localhost:8080/mascotas-desaparecidas", "host": ["localhost"], "port": "8080", "path": ["mascotas-desaparecidas"] }
          }
        },
        {
          "name": "2. Listar Todas Activas",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "http://localhost:8080/mascotas-desaparecidas", "host": ["localhost"], "port": "8080", "path": ["mascotas-desaparecidas"] }
          }
        },
        {
          "name": "3. Listar Mis Mascotas Desaparecidas",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer TOKEN" } ],
            "url": { "raw": "http://localhost:8080/mascotas-desaparecidas/mis-mascotas", "host": ["localhost"], "port": "8080", "path": ["mascotas-desaparecidas", "mis-mascotas"] }
          }
        },
        {
          "name": "4. Buscar por Zona",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/mascotas-desaparecidas/buscar?zona=Parque",
              "host": ["localhost"], "port": "8080", "path": ["mascotas-desaparecidas", "buscar"],
              "query": [
                { "key": "zona", "value": "Parque" }
              ]
            }
          }
        },
        {
          "name": "5. Marcar como Encontrada",
          "request": {
            "method": "PUT",
            "header": [],
            "url": { "raw": "http://localhost:8080/mascotas-desaparecidas/1/encontrada", "host": ["localhost"], "port": "8080", "path": ["mascotas-desaparecidas", "1", "encontrada"] }
          }
        }
      ]
    }
  ]
}